#VRML V2.0 utf8

DEF Arm2 
Transform {
    children [

      DEF Pin 
      Transform {
          rotation 0 0 1 1.57
          translation -10 57.5 100
            
          children [
              DEF pin1 
              Shape {
                  geometry Cylinder {
                      radius 10
                      height 200
                  }
                  appearance Appearance {
                      material Material {
                          diffuseColor 1 .9 .9
                      }
                  }
              }

            ]
        }

        DEF arm2 
        Shape {
            appearance Appearance {
                material Material {
                    diffuseColor 0.8 0.8 0.8
                }
            }

            geometry 
            IndexedFaceSet { 
                coord Coordinate {
                
                    point [ 0  0    0, 
                            85 0    0,
                            85 115  0, 
                            0  115  0,
                            5  22.5 274,
                            75 22.5 274,
                            75 92.5 274, 
                            5  92.5 274
                    ]
                }
                
                coordIndex [1, 0, 3, 2, -1 #frontface
                            0, 4, 7, 3, -1 #leftface
                            7, 6, 2, 3, -1 #backface
                            5, 1, 2, 6, -1 #topface
                            0, 1, 5, 4, -1 #rightface
                            4, 5, 6, 7, -1 #baseface
                ]
            }
        }

    ]
}