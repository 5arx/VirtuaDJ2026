Background {
    backUrl "clouds4.jpg"
    leftUrl "clouds4.jpg"
    rightUrl "clouds4.jpg"
    frontUrl "clouds4.jpg"
    topUrl "clouds4.jpg"
    bottomUrl "clouds4.jpg"
}





#######   ToolTip PROTO DECLARATION   #########
PROTO tooltipobject [ field MFString string []]
{
    Transform {
        translation -100 100 -150
        children [

            Billboard {
                axisOfRotation 0 0 0
                children [

                    Shape {
                        appearance Appearance {
                            material Material {
                                diffuseColor 1 1 0
                            }
                        }
                        geometry Text {
                            fontStyle FontStyle {
                                size 50
                                style "BOLD"                              
                            }
                            string IS string
                        }
                    }          
                
                ]
            }   

        ]
    }
}



#touchsensors routed to script
#which generates tooltips

    DEF ToolTip 
    Script {
        eventIn SFTime enabTime
        field SFBool enabled TRUE
        eventIn SFBool isOver
        eventIn SFBool ts2isOver  
        eventIn SFBool powerisOver
        eventIn SFBool StartisOver
        eventIn SFBool popLiteisOver
        eventIn SFBool popswitchisOver
        eventIn SFBool tonearmisOver      
        eventIn SFVec3f headshellisOver
        eventIn SFBool leverisOver
        eventIn SFVec3f sliderisOver      
        eventIn SFBool platterisOver      
        eventIn SFBool lite33isOver
        eventIn SFBool lite45isOver
        eventIn SFBool redLiteisOver
        eventIn SFBool toolisOver

        eventOut SFInt32 display
   
        url "tooltips.js"                
    }
                                   
     #this generates tooltip
     #objects in response to touchsensor
     #isOver/isActive events.
            DEF switch1 Switch {
                whichChoice -1
                choice [
        
             #0
                    tooltipobject {
                            string ""
                    }
                    

                    
              #1   
                            tooltipobject {
                            string "Power On/Off"
                            }
                                       
                    
               #2                            
                            tooltipobject {
                                string "Start-Stop Turntable"
                            }
               #3
                            tooltipobject {
                                string "Pop Up Light"
                            }  

               #4   
                            tooltipobject {
                                string "Light Switch"
                            }

               #5
                            tooltipobject {
                                string "Tonearm"
                            }

               #6
                            tooltipobject {
                                string "Headshell and Cartridge"
                            }

               #7   
                            tooltipobject {
                                string "Arm Lever"
                            }

               #8
                            tooltipobject {
                                string "Speed Adjuster"
                            }
                                
               #9
                            tooltipobject {
                                string "Platter"
                            }

               #10
                            tooltipobject {
                                string "331/3 rpm Speedbutton"
                            }

               #11
                            tooltipobject {
                                string "45 rpm Speedbutton"
                            }

               #12   
                            tooltipobject {
                                string "Strobe Lamp"
                            }  
                            
               #13
                            tooltipobject {
                                string "Show/Hide Tooltips"
                            }
                        ]
            }
           


                           


##### Navigation Information ##########

NavigationInfo{
   type "EXAMINE"
   headlight FALSE
   speed 25
}


    ############  ToolTip Switch  ###############

    DEF toolTipswitch Transform {
        translation -190 100 -200
        children [
            
            Transform {
                translation 0  30 0
                children
            Billboard {
                axisOfRotation 0 0 0
                children Shape {
                    appearance Appearance {
                        material Material {
                            diffuseColor 1 0 0
                        }
                    }
                    geometry Text {
                        fontStyle FontStyle {
                            size 140
                            style "BOLD"

                        }
                        string "?"
                    }
                    
                }
            }
        }
            DEF toolsensor TouchSensor {
                enabled TRUE
            }
        ] 
    }


    ############ Viewpoints ##############

Viewpoint { position -11.2688 297.513 461.721#0 400 500 
            orientation -1 0 0  0.6#-1 0 0 .6 
            description "Deck 2"
        }

       
                    
            

##########################################



############ Lights ##################

DirectionalLight  {  direction 0 -1 0 }

DirectionalLight  {  direction -1 0 0    }

