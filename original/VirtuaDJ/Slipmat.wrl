#VRML V2.0 utf8

#this is the slipmat
#Author: Indra Sarkar (msc46ixs)

DEF SlipMat Shape  {
    appearance Appearance {
        material Material {
            diffuseColor 0 .1 .1
            specularColor 0 0 0
            shininess 1
            }
        }
    geometry Cylinder {
        height 2
        radius 148
        }
    }

    DEF label Transform {
        translation 0 1 00
    
        children [

            Shape {
                appearance Appearance {
                    material Material {
                        diffuseColor .7 .7 .7
                    }
                }
                geometry Cylinder {
                    radius 40
                }
            }

            Transform {
                translation -30 1.5 -5
                rotation -1 0 0 1.57
                children [
                Shape {
                    appearance Appearance {
                        material Material {
                            diffuseColor 0 0 0
                        }
                    }
                    geometry Text {
                        fontStyle FontStyle {
                            size 19
                            style "BOLD"
                        }
                        string ["virtually",
                                " r  e  a  l"
                        ]
                    }
                }

            ]
            }

        ]
    }