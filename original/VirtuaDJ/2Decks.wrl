#VRML V2.0 utf8

NavigationInfo {
    headlight FALSE
    speed 100 
    avatarSize 1
    type "EXAMINE"
}

Viewpoint {
     description "Behind the Wheels of Steel"
     position   230 447.412 500
     orientation -1  0 0  0.6
     fieldOfView .8
}

WorldInfo {
    title "I Sarkar: SEM334 VR Project"
}

Background {
    backUrl "clouds4.jpg"
    leftUrl "clouds4.jpg"
    rightUrl "clouds4.jpg"
    frontUrl "clouds4.jpg"
    topUrl "clouds4.jpg"
    bottomUrl "clouds4.jpg"
}

Transform {
    translation 0 0 0
    children Inline {
        url "DeckI.wrl"
    }
}

Transform {
    translation 480 0 0
    children Inline {
        url "DeckII.wrl"
    }
}