     DEF ShellWeight Transform {
        translation 0 4 25
        children [
            Inline {
                url ["shellwt.wrl"]
            }
        ]
    }
    

    DEF handle
    Transform {
        translation 20 6 20
        children [
            Shape {
                appearance Appearance {
                    material Material {
                        diffuseColor .1 .1 .3
                    }
                }
                geometry Box {
                    size 25 2 2
                }
            }
        ]
    }




    DEF Leftscrew 
    Transform {
        translation -3.8 7.5 24
        children [
            DEF screw Inline {
                url ["screw.wrl"]
            }    
        ]
    }


    DEF Rightscrew 
    Transform {
        translation 3.8 7.5 24
        children USE screw
            
	}    
        
    

    ]

}






              