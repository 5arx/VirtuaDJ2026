            translation 0 1 0
            children [
              Shape {
                appearance Appearance {
                  material Material {
                    diffuseColor .6 .6 .6  # 0 0 0
                  }
                }
                geometry Cylinder { radius 6 height 2 }
              }
        ] }
      ]
    }

