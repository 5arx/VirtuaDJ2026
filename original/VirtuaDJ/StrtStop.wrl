#VRML V2.0 utf8

#This is the start-stop switch
#Author: Indra Sarkar


DEF startStopSwitch Group {
    children [ 
        DEF StartStop Shape {
            appearance DEF Chromy Appearance {
                material Material {
                    diffuseColor 0.8 0.8 0.8
                    shininess .8
                    specularColor .95 .95 1
                    }
                 }
            
            geometry Box {
                size 38 3 28.5 
                }
            }
            
        DEF StartStopSurround Shape {
            appearance Appearance {
                material Material {
                    diffuseColor 0 0 .01
                    }
                }
            geometry Box  {
                size 42 2 30
                }
            }
                              
        Transform {
        rotation -1 0 0 1.57
        translation -10 1.7 0                 
        children
            DEF StartStopLabel Shape {
                appearance Appearance {
                    material Material {
                        diffuseColor .1 .1 .1
                    }
                }
                geometry Text {
                string ["Start-Stop"]
                fontStyle FontStyle {
                    style "BOLD"
                    size 6
                    }
                }
                }
            }
            ]         
         }  
                    