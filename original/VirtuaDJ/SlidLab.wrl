Shape {
    geometry Text {
        fontStyle FontStyle {
                size 6
                style "BOLD"
                spacing .7
            }
        string ["+ 8", "",
                " - ", "", "  6", "",
                " - ", "", "  4", "",
                " - ", "", "  2", "",
                " - ", "", " 0 ", "",
                " - ", "", "  2", "",
                " - ", "", "  4", "",
                " - ", "", "  6", "",
                " - ",  "",
                "- 8"
            ]   
    }
}