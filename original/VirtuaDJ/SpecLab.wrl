#VRML V2.0 utf8

#this is the specifications label (underside of deck body)
#Author: Indra Sarkar (msc46ixs)


Shape {
    geometry Text {
        fontStyle FontStyle {
                size 5
                style "BOLD"
            }
        string ["Technics SL1210 mk.III",
                "Specifications", 
                "Dimensions:             45.3 x 16.2 x 36 cm", 
                "Weight:                     12.5 kg", 


                "",
                "Turntable",
                "Type:                         Quartz Direct Drive",
                "                                   Manual turntable",
                "Motor:                       Brushless DC Motor",
                "Turntable Platter     Aluminium Diecast",
                "                                   Diameter 33.2 cm",
                "                                   Weight 2 kg"  ,
                "Turntable Speeds:    33-1/3 rpm and 45 rpm",
                "Starting Torque:      1.5 kg.cm",
                "Build-up",
                "characteristics         0.7 s from standstill to 33-1/3 rpm",
                "Braking System:      Electronic brake",
                "Speed change due to",
                "  load torque:             0% within 1.0 kg.cm",
                "Wow and flutter:        0.01% WRMS",
                "Rumble:                     -56dB (IEC 98A Unweighted",
                "                                    -78dB (IEC 98A Weighted",
                "",
                "",
                "Tonearm Section",
                "Type:                     Universal",
                "Effective length:          230 mm",
                "Arm height adjustment:       31.8-37.8 mm",
                "Overhang:             15 mm",
                "Effective mass:        12 g (without cartridge)",
                "Offset angle:            22' ",
                "Friction:           Less than 7 mg (lateral, vertical)",
                "Tracking error angle:      Within 2'32' "
            ]   
    }
}