{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VirtualDJ: Install Dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}/source"
      },
      "problemMatcher": []
    },
    {
      "label": "VirtualDJ: Build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/source"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "VirtualDJ: Dev Server",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/source"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*"
        }
      }
    },
    {
      "label": "VirtualDJ: Production Preview",
      "type": "shell",
      "command": "npm run preview -- --host 127.0.0.1 --port 4173 --strictPort",
      "options": {
        "cwd": "${workspaceFolder}/source"
      },
      "dependsOn": "VirtualDJ: Build",
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite preview.*",
          "endsPattern": ".*Local:.*"
        }
      }
    }
  ]
}
